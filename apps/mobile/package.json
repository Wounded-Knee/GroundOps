{
  "name": "@groundops/mobile",
  "version": "0.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "~15.0.3",
    "@groundops/contracts": "workspace:*",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.25",
    "expo-auth-session": "~57.0.13",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-maps": "~57.0.3",
    "expo-notifications": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "node --env-file=../../.env ./scripts/expo-with-env.mjs start",
    "typecheck": "tsc --noEmit",
    "android": "../../scripts/android.sh start",
    "run:android": "../../scripts/android.sh run",
    "ios": "node --env-file=../../.env ./scripts/expo-with-env.mjs start --ios",
    "web": "node --env-file=../../.env ./scripts/expo-with-env.mjs start --web"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-maps"
        ]
      }
    }
  },
  "private": true
