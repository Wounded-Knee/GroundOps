# Purpose: PostgreSQL connection for the API (apps/server/src/db.ts).
# Source: local database created with `createdb groundops`. The host query param is the Postgres socket directory. The server connects as the OS user who owns that database.
DATABASE_URL=postgres:///groundops?host=/var/run/postgresql

# Purpose: NATS address for live fanout (apps/server/src/bus.ts).
# Source: Docker Compose service in this repo, published on localhost:4222.
NATS_URL=nats://localhost:4222

# Purpose: TCP port the API listens on (apps/server/src/index.ts).
# Source: local choice. 3000 matches EXPO_PUBLIC_API_URL below.
PORT=3000

# Purpose: API origin baked into the Expo client (apps/mobile/src/apiUrl.ts).
# Source: the server's host and PORT. On a device, a loopback host is rewritten to the Metro dev host.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Purpose: OAuth client secret for the Google Cloud "Web application" client.
# Source: Google Cloud Console, APIs & Services, Credentials, that client's secret. Confidential. Sign-in does not read this variable.
GOOGLE_WEB_CLIENT_SECRET=

# Purpose: web Google client id. The server checks token audience against it (apps/server/src/identity/google.ts). The Expo dev script copies it into the web client bundle (apps/mobile/App.tsx).
# Source: Google Cloud Console, the Web application's client id.
GOOGLE_WEB_CLIENT_ID=

# Purpose: Android Google client id. The server checks token audience against it. The Expo app sends it when running on Android. A native rebuild registers the reversed client id as a URL scheme so Google can return the authorization code.
# Source: Google Cloud Console, the Android OAuth client created with package com.groundops.app and the debug SHA-1.
GOOGLE_ANDROID_CLIENT_ID=

# Purpose: iOS Google client id. The server checks token audience against it. The Expo app sends it when running on iOS.
# Source: Google Cloud Console, the iOS OAuth client (bundle id and Apple Team ID). Empty until that client exists.
GOOGLE_IOS_CLIENT_ID=

# Purpose: server key for place suggestions and driving routes (apps/server/src/routing/google.ts). The client never receives it.
# Source: Google Cloud Console, an API key with Places API (New) and Routes API enabled.
GOOGLE_MAPS_API_KEY=

# Purpose: Android map tiles. The Expo config copies it to android.config.googleMaps.apiKey when the development build is created. It is not the routing key.
# Source: Google Cloud Console, an API key restricted to the Android app com.groundops.app and the Maps SDK for Android.
GOOGLE_MAPS_ANDROID_API_KEY=
